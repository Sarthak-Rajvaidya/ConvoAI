# ==============================================================================
# AI Meeting Intelligence Assistant — Environment Configuration
# ==============================================================================
# Copy this file to `.env` and fill in your own values.
# NEVER commit your real `.env` file — it is already in .gitignore.
# ==============================================================================

# ------------------------------------------------------------------------------
# Groq — transcription (Whisper) + chat/analysis generation
# ------------------------------------------------------------------------------
# Get a free API key at https://console.groq.com
GROQ_API_KEY=
# Fast model used for meeting analysis and RAG chat answers.
GROQ_CHAT_MODEL=openai/gpt-oss-20b
# Higher-quality model, available for cases that want it (not used by default).
GROQ_CHAT_MODEL_HIGH_QUALITY=openai/gpt-oss-120b

GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# ------------------------------------------------------------------------------
# Transcription provider
# ------------------------------------------------------------------------------
# "groq" (default, cloud, fast) or "local" (offline openai-whisper fallback;
# requires `pip install openai-whisper` separately).
TRANSCRIPTION_PROVIDER=groq
WHISPER_LOCAL_MODEL=small

# Audio larger than this is segmented and transcribed in parallel chunks.
MAX_AUDIO_SEGMENT_MB=24
AUDIO_CHUNK_SECONDS=600
MAX_PARALLEL_TRANSCRIPTIONS=4

# ------------------------------------------------------------------------------
# Qdrant Cloud — vector database for RAG
# ------------------------------------------------------------------------------
# Create a free cluster at https://cloud.qdrant.io
# If left empty, the app still works: chat automatically falls back to
# transcript-based lexical search instead of semantic search.
QDRANT_URL= 
QDRANT_API_KEY=
QDRANT_COLLECTION=meeting_transcripts

# ------------------------------------------------------------------------------
# Embeddings
# ------------------------------------------------------------------------------
# FastEmbed model (ONNX runtime, no torch dependency). Changing this changes
# the vector dimension; do not mix embeddings from different models in the
# same Qdrant collection.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ------------------------------------------------------------------------------
# RAG behaviour
# ------------------------------------------------------------------------------
RAG_TOP_K=5
RAG_MIN_SCORE=0.22
RAG_CHUNK_SIZE_WORDS=180
RAG_CHUNK_OVERLAP_WORDS=30
CHAT_HISTORY_TURNS=6

# ------------------------------------------------------------------------------
# Uploads
# ------------------------------------------------------------------------------
MAX_UPLOAD_MB=300

# ------------------------------------------------------------------------------
# App behaviour
# ------------------------------------------------------------------------------
# Set to true to enable a sample-meeting demo mode (no API calls/credits used).
DEMO_MODE=false
LOG_LEVEL=INFO
